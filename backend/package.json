{
  "name": "hirelens-ai-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for HireLens AI resume-to-job gap analysis.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:create": "tsx scripts/createDb.ts",
    "db:setup": "npm run db:create && npm run db:init",
    "db:init": "tsx scripts/initDb.ts"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
