{
  "name": "ai-powered-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:start": "npm --prefix backend start",
    "backend:test": "npm --prefix backend test",
    "backend:db:create": "npm --prefix backend run db:create",
    "backend:db:setup": "npm --prefix backend run db:setup",
    "backend:db:init": "npm --prefix backend run db:init",
    "legacy:dev": "node scripts/dev.js",
    "legacy:server": "node server/index.js",
    "legacy:server:dev": "nodemon --watch server --ext js,json --exec node server/index.js",
    "test": "npm --prefix backend test",
    "test:watch": "npm --prefix backend run test:watch",
    "client": "vite --host 0.0.0.0",
    "client:build": "vite build",
    "build": "npm --prefix backend run build",
    "start": "npm --prefix backend start"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "nodemon": "^3.1.14",
    "vite": "^7.1.3"
  }
}
